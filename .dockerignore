# Heavy host-only directories — keep them out of the build context so
# buildkit's `COPY . .` doesn't smash the deps stage's own node_modules
# and so we don't ship local build output / secrets into images.

**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/.nyc_output

# TypeScript incremental state. `**/dist` is excluded above, so a
# tsbuildinfo that survives into the build context makes `tsc` believe the
# emitted files are current and emit nothing — every package importing the
# skipped one then fails with "Cannot find module '@mergecrew/domain'".
# The image must always compile from source, whatever the worktree holds.
**/*.tsbuildinfo

# Local secrets and editor scratch.
.env
.env.*
!.env.example
.DS_Store
*.log
.logs/

# Git metadata (not needed at runtime; included via build args if we ever care).
.git
.gitignore

# Docker tooling output.
docker-compose.override.yml

# IDE
.vscode
.idea

# Dev-only artifacts
.claude
